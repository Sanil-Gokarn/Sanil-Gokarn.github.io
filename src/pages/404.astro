---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---

<Base title="Page not found">
  <section class="container-page py-28 text-center">
    <p class="font-mono text-6xl font-semibold text-accent">404</p>
    <h1 class="mt-4 text-2xl font-semibold tracking-tight">This page doesn't exist</h1>
    <p class="mt-3 text-muted">It may have moved, or the link might be wrong.</p>
    <div class="mt-8 flex justify-center gap-3">
      <a href="/" class="btn-primary"><Icon name="arrow-left" /> Home</a>
      <a href="/projects/" class="btn-secondary">All projects</a>
    </div>
  </section>
</Base>
