---
// Small inline icon set (24px grid, stroke-based).
interface Props {
  name:
    | 'arrow-right'
    | 'arrow-left'
    | 'arrow-up-right'
    | 'github'
    | 'linkedin'
    | 'mail'
    | 'sun'
    | 'moon'
    | 'menu'
    | 'close'
    | 'pin'
    | 'file'
    | 'award'
    | 'globe'
    | 'chart'
    | 'sparkle'
    | 'user';
  class?: string;
}
const { name, class: className = 'size-4' } = Astro.props;
---

<svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'arrow-right' && <path d="M5 12h14M13 6l6 6-6 6" />}
  {name === 'arrow-left' && <path d="M19 12H5M11 18l-6-6 6-6" />}
  {name === 'arrow-up-right' && <path d="M7 17 17 7M8 7h9v9" />}
  {name === 'github' && (
    <path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21" />
  )}
  {name === 'linkedin' && (
    <>
      <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z" />
      <path d="M2 9h4v12H2z" />
      <circle cx="4" cy="4" r="2" />
    </>
  )}
  {name === 'mail' && (
    <>
      <rect x="3" y="5" width="18" height="14" rx="2" />
      <path d="m3 7 9 6 9-6" />
    </>
  )}
  {name === 'sun' && (
    <>
      <circle cx="12" cy="12" r="4" />
      <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
    </>
  )}
  {name === 'moon' && <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />}
  {name === 'menu' && <path d="M4 7h16M4 12h16M4 17h16" />}
  {name === 'close' && <path d="M6 6l12 12M18 6 6 18" />}
  {name === 'pin' && (
    <>
      <path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z" />
      <circle cx="12" cy="9.5" r="2.5" />
    </>
  )}
  {name === 'file' && (
    <>
      <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" />
      <path d="M14 3v5h5M9 13h6M9 17h6" />
    </>
  )}
  {name === 'award' && (
    <>
      <circle cx="12" cy="9" r="6" />
      <path d="M8.5 14 7 22l5-3 5 3-1.5-8" />
    </>
  )}
  {name === 'chart' && <path d="M3 20h18M6 20v-6M11 20V5M16 20v-9M21 20v-4" />}
  {name === 'sparkle' && <path d="M12 3l1.9 5.6L19.5 10.5l-5.6 1.9L12 18l-1.9-5.6L4.5 10.5l5.6-1.9zM19 16l.8 2.2L22 19l-2.2.8L19 22l-.8-2.2L16 19l2.2-.8z" />}
  {name === 'user' && (
    <>
      <circle cx="12" cy="8" r="4" />
      <path d="M4 21a8 8 0 0 1 16 0" />
    </>
  )}
  {name === 'globe' && (
    <>
      <circle cx="12" cy="12" r="9" />
      <path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18" />
    </>
  )}
</svg>
