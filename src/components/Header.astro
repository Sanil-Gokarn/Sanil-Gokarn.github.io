---
import Icon from './Icon.astro';
import { profile } from '../data/profile';

const links = [
  { label: 'Projects', href: '/projects/' },
  { label: 'About', href: '/#about' },
  { label: 'Process', href: '/#process' },
  { label: 'Experience', href: '/#experience' },
];
const path = Astro.url.pathname;
const linkedin = profile.socials.find((s) => s.label === 'LinkedIn');
---

<header class="sticky top-0 z-40 bg-bg/85 backdrop-blur-md">
  <div class="container-page flex h-[4.5rem] items-center justify-between gap-4">
    <a href="/" class="text-lg font-semibold tracking-tight">{profile.name}</a>

    <nav aria-label="Main" class="hidden items-center rounded-full bg-surface p-1 shadow-[0_1px_2px_rgba(0,0,0,0.06)] md:flex">
      {
        links.map((link, i) => (
          <>
            {i > 0 && <span class="h-5 w-px bg-line" aria-hidden="true" />}
            <a
              href={link.href}
              class:list={['rounded-full px-4 py-2 text-sm transition-colors hover:text-ink', path.startsWith(link.href) ? 'text-ink' : 'text-muted']}
              aria-current={path.startsWith(link.href) ? 'page' : undefined}
            >
              {link.label}
            </a>
          </>
        ))
      }
      <a href="/#contact" class="ml-1 grid size-9 place-items-center rounded-full bg-accent text-on-accent hover:opacity-90" aria-label="Contact">
        <Icon name="mail" />
      </a>
    </nav>

    <div class="flex items-center gap-1">
      <button
        type="button"
        data-theme-toggle
        class="grid size-9 place-items-center rounded-full text-muted transition-colors hover:bg-surface hover:text-ink"
        aria-label="Switch colour theme"
      >
        <span class="dark:hidden"><Icon name="moon" class="size-[18px]" /></span>
        <span class="hidden dark:block"><Icon name="sun" class="size-[18px]" /></span>
      </button>
      {
        linkedin && (
          <a href={linkedin.href} target="_blank" rel="noopener" class="ml-1 hidden rounded-full border border-line px-4 py-2 text-sm hover:border-ink sm:inline-flex">
            LinkedIn
          </a>
        )
      }
      <button
        type="button"
        data-menu-toggle
        class="grid size-9 place-items-center rounded-full text-muted hover:bg-surface hover:text-ink md:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span data-menu-open><Icon name="menu" class="size-5" /></span>
        <span data-menu-close class="hidden"><Icon name="close" class="size-5" /></span>
      </button>
    </div>
  </div>

  <nav id="mobile-menu" aria-label="Main" class="hidden border-t border-line md:hidden">
    <ul class="container-page flex flex-col py-2">
      {
        [...links, { label: 'Contact', href: '/#contact' }].map((link) => (
          <li>
            <a href={link.href} class="block py-3 text-base text-muted hover:text-ink">
              {link.label}
            </a>
          </li>
        ))
      }
      {
        linkedin && (
          <li>
            <a href={linkedin.href} target="_blank" rel="noopener" class="flex items-center gap-1.5 py-3 text-base text-muted hover:text-ink">
              LinkedIn
              <Icon name="arrow-up-right" class="size-4" />
            </a>
          </li>
        )
      }
    </ul>
  </nav>
</header>

<script>
  const themeButton = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  themeButton?.addEventListener('click', () => {
    const dark = document.documentElement.classList.toggle('dark');
    try {
      localStorage.setItem('theme', dark ? 'dark' : 'light');
    } catch {}
  });

  const menuButton = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.getElementById('mobile-menu');
  const setMenu = (open: boolean) => {
    menu?.classList.toggle('hidden', !open);
    menuButton?.setAttribute('aria-expanded', String(open));
    menuButton?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    menuButton?.querySelector('[data-menu-open]')?.classList.toggle('hidden', open);
    menuButton?.querySelector('[data-menu-close]')?.classList.toggle('hidden', !open);
  };
  menuButton?.addEventListener('click', () => setMenu(menu?.classList.contains('hidden') ?? false));
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMenu(false)));
</script>
